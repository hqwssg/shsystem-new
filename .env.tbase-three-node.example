# Copy to /opt/shsystem-tbase/.env and replace every placeholder with the
# vendor-confirmed value. Do not use this file as production credentials.
APP_IMAGE=replace-with-local-app-image
PYTHON_IMAGE=replace-with-local-python-image
TBASE_NODE_IMAGE=replace-with-vendor-confirmed-tbase-image

SHARED_DATA_HOST_PATH=/opt/shsystem-tbase/shared
TBASE_PACKAGE_HOST_PATH=/opt/shsystem-tbase/vendor/tbase
TBASE_NODE1_DATA=/opt/shsystem-tbase/tbase/node1
TBASE_NODE2_DATA=/opt/shsystem-tbase/tbase/node2
TBASE_NODE3_DATA=/opt/shsystem-tbase/tbase/node3

TBASE_NODE1_NAME=node1
TBASE_NODE2_NAME=node2
TBASE_NODE3_NAME=node3
TBASE_NODE1_ROLES=replace-with-role.info-node1-roles
TBASE_NODE2_ROLES=replace-with-role.info-node2-roles
TBASE_NODE3_ROLES=replace-with-role.info-node3-roles

CERDB_JDBC_DRIVER=replace-with-vendor-jdbc-driver
CERDB_JDBC_URL=replace-with-vendor-jdbc-url
CERDB_HOST=tbase-node1
TBASE_COORDINATOR_PORT=replace-with-vendor-coordinator-port
TBASE_DATANODE_PORT=replace-with-vendor-datanode-port
TBASE_GTM_PORT=replace-with-vendor-gtm-port
CERDB_PORT=replace-with-vendor-client-port
CERDB_DB=carbon_emissions
CERDB_APP_USER=replace-with-app-user
CERDB_APP_PASSWORD=replace-with-random-secret
CERDB_DSN=replace-with-vendor-python-dsn
ENERGY_DATABASE_URL=replace-with-vendor-energy-dsn

PYTHON_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
PREDICTION_API_KEY=replace-with-separate-random-secret
WEB_PORT=80
