RELEASE=1.0.0
APP_IMAGE=registry.example.internal/shsystem/app:1.0.0
PYTHON_IMAGE=registry.example.internal/shsystem/python:1.0.0
MYSQL_IMAGE=mysql:8.0
MYSQL_DATA_HOST_PATH=/srv/shsystem/data/mysql
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
DATABASE_NAME=carbon_emissions
DATABASE_USER=shsystem_app
DATABASE_PASSWORD=replace-with-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
SHARED_DATA_HOST_PATH=/srv/shsystem/data/shared
PYTHON_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
PREDICTION_API_KEY=replace-with-separate-random-secret
WEB_PORT=80
