RELEASE=1.0.0
APP_IMAGE=registry.example.internal/shsystem/app:1.0.0
PYTHON_IMAGE=registry.example.internal/shsystem/python:1.0.0
CERDB_IMAGE=vendor-confirmed-image:version
CERDB_DATA_HOST_PATH=/srv/shsystem/data/cerdb
CERDB_LICENSE_HOST_PATH=/srv/shsystem/vendor/cerdb-license
SHARED_DATA_HOST_PATH=/srv/shsystem/data/shared
CERDB_HOST=cerdb
CERDB_PORT=5432
CERDB_DB=carbon_emissions
CERDB_APP_USER=shsystem_app
CERDB_APP_PASSWORD=replace-with-random-secret
CERDB_JDBC_DRIVER=org.postgresql.Driver
CERDB_JDBC_URL=jdbc:postgresql://cerdb:5432/carbon_emissions
CERDB_DSN=postgresql://shsystem_app:replace-with-random-secret@cerdb:5432/carbon_emissions
ENERGY_DATABASE_URL=postgresql://shsystem_app:replace-with-random-secret@cerdb:5432/carbon_emissions
PYTHON_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
PREDICTION_API_KEY=replace-with-separate-random-secret
PYTHON_BIND_ADDRESS=127.0.0.1
PREDICTION_BIND_ADDRESS=127.0.0.1
PYTHON_PORT=8091
PREDICTION_PORT=8090
PYTHON_SERVICE_URL=http://10.20.0.12:8091
PREDICTION_BASE_URL=http://10.20.0.12:8090
WEB_PORT=80
